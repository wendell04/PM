# ╔════════════════════════════════════════════════════════════════╗
# ║           FRONTEND ENVIRONMENT CONFIGURATION                   ║
# ║                                                                ║
# ║ INSTRUCTIONS:                                                  ║
# ║ 1. Copy this file to .env.local                                ║
# ║ 2. Update the values for your environment                      ║
# ║ 3. Restart the development server after changes                ║
# ╚════════════════════════════════════════════════════════════════╝

# ════════════════════════════════════════════════════════════════
# API Configuration
# ════════════════════════════════════════════════════════════════
# Backend API URL - where your Laravel server is running
# Local development: http://127.0.0.1:8000
# Production: https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ════════════════════════════════════════════════════════════════
# Application
# ════════════════════════════════════════════════════════════════
# App name displayed in the UI
NEXT_PUBLIC_APP_NAME=PersonalizeMe Prints

# ════════════════════════════════════════════════════════════════
# Shipping
# ════════════════════════════════════════════════════════════════
# Flat delivery fee in PHP pesos (shown on checkout)
NEXT_PUBLIC_DELIVERY_FEE=80

# ════════════════════════════════════════════════════════════════
# Sentry Error Monitoring (https://sentry.io — leave blank to disable)
# ════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
