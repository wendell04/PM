# Build-time public config for the production frontend (Cloudflare Pages / OpenNext).
#
# NEXT_PUBLIC_* are inlined into the browser bundle by `next build`, so they must exist at
# BUILD time. Cloudflare dashboard "Secrets" are runtime-only and never reach `next build`,
# which is why the app fell back to its in-code localhost default and register hit
# http://127.0.0.1:8000. Every value here is public (it ships to the browser), so it belongs
# in the repo. Do NOT put real secrets (API secret keys, passwords) in any NEXT_PUBLIC_* var.
NEXT_PUBLIC_API_URL=https://api.personalizemeprints.com

# The SSA forecast service. THIS IS NOT SET, and the consequence is the same one
# described above: with the variable missing, `next build` inlines the in-code
# default of http://localhost:8001 into the bundle, so Demand Forecast, Home and
# Reports all call the VIEWER'S OWN MACHINE and fail for every real user. The CSP
# connect-src in next.config.js is built from the same variable, so it whitelists
# the wrong host too - setting it at runtime only is not enough.
#
# The service itself (ssa-service/, FastAPI on 8001) has no deployment config in
# this repo yet. Once it is hosted, put its public origin here AND set
# SSA_ALLOWED_ORIGINS on the service to the dashboard origin, or the browser will
# block the call.
# NEXT_PUBLIC_SSA_API_URL=https://<the-ssa-host>
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_ANEE81xYWAFneV3nySjC39mn
